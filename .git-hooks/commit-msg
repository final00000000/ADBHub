#!/usr/bin/env bash

# Git Commit 禁止 AI 署名 Hook
# 自动检查并移除 AI 相关的署名信息

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# 检测 AI 署名的关键词
ai_signatures=(
    "Co-authored-by:.*Claude"
    "Co-authored-by:.*ChatGPT"
    "Co-authored-by:.*Copilot"
    "Co-authored-by:.*AI"
    "Generated by Claude"
    "Generated by ChatGPT"
    "Generated by AI"
    "With assistance from Claude"
    "With assistance from ChatGPT"
    "AI-assisted"
    "AI-generated"
    "Pair programmed with Claude"
    "Pair programmed with ChatGPT"
)

# 检查是否包含 AI 署名
has_ai_signature=false
for pattern in "${ai_signatures[@]}"; do
    if echo "$commit_msg" | grep -qiE "$pattern"; then
        has_ai_signature=true
        break
    fi
done

if [ "$has_ai_signature" = true ]; then
    echo "❌ 错误: 提交信息包含 AI 署名"
    echo ""
    echo "检测到以下 AI 相关署名："
    for pattern in "${ai_signatures[@]}"; do
        if echo "$commit_msg" | grep -qiE "$pattern"; then
            echo "  - $(echo "$commit_msg" | grep -iE "$pattern")"
        fi
    done
    echo ""
    echo "请移除 AI 署名后再提交。"
    echo "提示: 使用 git commit --amend 修改提交信息"
    exit 1
fi

# 自动清理常见的 AI 标记
cleaned_msg=$(echo "$commit_msg" | sed -E '
    /Co-authored-by:.*Claude/Id
    /Co-authored-by:.*ChatGPT/Id
    /Co-authored-by:.*Copilot/Id
    /Co-authored-by:.*AI/Id
    /Generated by (Claude|ChatGPT|AI)/Id
    /With assistance from (Claude|ChatGPT|AI)/Id
    /AI-(assisted|generated)/Id
    /Pair programmed with (Claude|ChatGPT)/Id
')

# 如果清理后内容有变化，更新文件
if [ "$cleaned_msg" != "$commit_msg" ]; then
    echo "$cleaned_msg" > "$commit_msg_file"
    echo "✓ 已自动移除 AI 署名信息"
fi

exit 0
